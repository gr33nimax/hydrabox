* text=auto

*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.arb text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.gradle text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.svg text eol=lf
*.ttf binary
*.otf binary
*.aar binary
*.jar binary
*.srs binary
*.jks binary
*.keystore binary

# A full extended-core Android archive can exceed GitHub's 100 MiB Git blob
# limit. Keep the reproducible AAR in the fork without dropping architectures
# or protocol implementations.
android/app/libs/libbox.aar filter=lfs diff=lfs merge=lfs -text
