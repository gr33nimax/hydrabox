<?xml version="1.0" encoding="utf-8"?>
<!--
  The foreground is the artwork itself, resolved per density: mipmap-*/ic_launcher_foreground.png
  is exactly 108 dp, so its intrinsic size matches the adaptive-icon canvas and nothing has to be
  stretched at render time. The artwork keeps its own >=16.7% margin, so the mask never reaches it.
  A drawable-nodpi bitmap wrapped in a layer-list used to draw at its pixel size instead
  (640 px = 213 dp on a 3x screen) and the mask showed the middle of the artwork.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
