<?xml version="1.0" encoding="utf-8"?>
<!--
  The foreground is the artwork itself, resolved per density: mipmap-*/ic_launcher_foreground.png
  is exactly 108 dp, so its intrinsic size matches the adaptive-icon canvas and nothing has to be
  stretched at render time. The monochrome layer follows the same rule, which also puts the themed
  glyph on the same 108 dp canvas as the colour one instead of the 50 dp box it used to sit in.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
